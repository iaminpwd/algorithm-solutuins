def solution(n, words):
    answer = set([words[0]])

    for i in range(1, len(words)):
        current_word = words[i]
        prev_word = words[i-1]

        if current_word in answer or prev_word[-1] != current_word[0]:
            return [i%n+1, i//n+1]

        answer.add(current_word)
    return [0,0]
